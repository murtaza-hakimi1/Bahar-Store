# Copy this file to .env and fill in your real SMTP details.
# Never commit .env or expose SMTP credentials in frontend code.
API_PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-store-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=owner@example.com
# Set this to your deployed frontend origin when hosting frontend and API separately.
CORS_ORIGIN=https://your-store-frontend.example

# Optional when the frontend and API are deployed on different domains:
# VITE_API_URL=https://your-api-domain.example
